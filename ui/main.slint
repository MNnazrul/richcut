import { LineEdit, ListView } from "std-widgets.slint";

export component MainWindow inherits Window {
    title: "ClipList";
    preferred-width: 420px;
    preferred-height: 540px;
    background: #f5f5f7;

    in-out property <string> search-text: "";
    in property <[string]> clipboard-items: [];
    in-out property <string> selected-content: "";

    VerticalLayout {
        padding: 20px;
        spacing: 14px;

        Text {
            text: "Clipboard Hisotry";
            color: #202124;
            font-size: 23px;
            font-weight: 700;
        }

        LineEdit {
            placeholder-text: "Search clipboard...";
            text <=> root.search-text;
            height: 38px;
        }

        Rectangle {
            background: white;
            border-radius: 12px;
            border-width: 1px;
            border-color: #e2e2e7;
            clip: true;

            ListView {
                for item in root.clipboard-items: Rectangle {
                    height: 58px;
                    background: row-touch.has-hover ? #f1f1f5 : white;

                    VerticalLayout {
                        padding: 10px;
                        spacing: 4px;

                        Text {
                            text: item;
                            color: #222228;
                            font-size: 13px;
                            overflow: elide;
                            vertical-alignment: center;
                        }

                        Text {
                            text: "Clipboard item";
                            color: #888890;
                            font-size: 11px;
                        }
                    }

                    row-touch := TouchArea {
                        clicked => {
                            root.selected-content = item;
                        }
                    }

                    Rectangle {
                        x: 10px;
                        y: parent.height - 1px;
                        width: parent.width - 20px;
                        height: 1px;
                        background: #eeeeef;
                    }
                }
            }
        }

        Text {
            text: "Preview";
            color: #202124;
            font-size: 14px;
            font-weight: 600;
        }

        Rectangle {
            background: white;
            border-radius: 10px;
            border-width: 1px;
            border-color: #e2e2e7;
            height: 80px;

            Text {
                x: 10px;
                y: 10px;
                width: parent.width - 20px;
                height: parent.height - 20px;
                text: root.selected-content;
                color: #44444a;
                font-size: 12px;
                wrap: word-wrap;
                overflow: elide;
                vertical-alignment: top;
            }
        }
    }
}
